  "info": {
    "_postman_id": "7c6a9a2b-d449-4234-b5e8-752dc9955bfa",
    "name": "PDFEndpoint Account Renders API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Lightweight HTML and URL to PDF conversion API. A single POST /convert endpoint renders raw HTML or a publicly accessible HTTPS URL into a PDF using a headless browser, with options for page size, margins, orientation, headers and footers, encryption, and multiple delivery modes. Additional endpoints list, remove, and report usage for generated renders.\n\nContact Support:\n Name: PDFEndpoint Support",
      "type": "text/plain"
    }
  }
